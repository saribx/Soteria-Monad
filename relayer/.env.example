# local | testnet | mainnet
MONAD_NETWORK=local

# Wallet that holds the MON (not needed for local). Never commit .env.
FUNDER_PRIVATE_KEY=

# Hard ceiling on MON spent on gas per relayer run (defaults: testnet 5, mainnet 16 = one full demo)
# MAX_MON_SPEND=16

# Minutes without a control action before a live demo closes itself (defaults: testnet 30, mainnet 15)
# MAX_LIVE_MIN=15

# Optional: own RPC endpoints (comma separated) and their rate limit
# RPC_URLS=https://...
# RPC_RPS=20
# WS_URL=wss://...
